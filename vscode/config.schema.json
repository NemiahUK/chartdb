{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ChartDB repository configuration",
    "type": "object",
    "additionalProperties": false,
    "required": ["version", "schema", "layout"],
    "properties": {
        "version": { "const": 1 },
        "name": { "type": "string", "description": "Diagram title" },
        "schema": {
            "type": "string",
            "description": "Path to generated DBML, relative to the repository root"
        },
        "layout": {
            "type": "string",
            "description": "Path to the layout-only JSON file"
        },
        "importLayoutFrom": {
            "type": "string",
            "description": "Existing ChartDB JSON export; read only if the layout file does not exist"
        },
        "databaseType": {
            "enum": [
                "generic",
                "postgresql",
                "mysql",
                "sql_server",
                "mariadb",
                "sqlite",
                "clickhouse",
                "cockroachdb",
                "oracle"
            ],
            "default": "generic"
        }
    }
}
