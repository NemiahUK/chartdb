{
    "name": "chartdb-repository",
    "displayName": "ChartDB Repository Diagrams",
    "description": "View DBML and edit diagram layouts alongside your repository.",
    "version": "0.1.2",
    "publisher": "nemiah",
    "license": "AGPL-3.0-only",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "main": "./dist/extension.cjs",
    "extensionKind": [
        "workspace"
    ],
    "activationEvents": [
        "onCommand:chartdb.open",
        "onLanguage:json",
        "onLanguage:jsonc",
        "workspaceContains:.chartdb.json"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "ChartDB writes diagram layouts to the configured workspace files."
        },
        "virtualWorkspaces": {
            "supported": false
        }
    },
    "contributes": {
        "commands": [
            {
                "command": "chartdb.open",
                "title": "ChartDB: Open Repository Diagram",
                "icon": "$(preview)"
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "/.chartdb.json",
                "url": "./config.schema.json"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "chartdb.open",
                    "when": "isWorkspaceTrusted && resourcePath in chartdb.diagramPaths",
                    "group": "navigation"
                }
            ]
        }
    }
}
